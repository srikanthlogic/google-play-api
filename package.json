{
  "name": "google-play-api",
  "version": "1.6.0",
  "description": "turn google play scraper into a RESTful API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node test.js",
    "generateoas": "p2o ./PostmanCollections/GooglePlayAPI.postman_collection.json -o ./openapi/options.json -f ./openapi/swagger.json",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prepare": "husky"
  },
  "author": "Facundo Olano",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/srikanthlogic/google-play-api.git"
  },
  "dependencies": {
    "@mradex77/google-play-scraper": "^1.1.0",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.1",
    "morgan": "^1.10.1",
    "pino": "^10.3.1",
    "postman-to-openapi": "^3.0.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@usebruno/cli": "^1.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-standard": "^5.0.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "npm-check-updates": "^17.1.18",
    "pino-pretty": "^13.1.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  }
}
