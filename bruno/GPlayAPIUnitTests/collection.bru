meta {
  name: GPlayAPIUnitTests
  description: Unit tests for GPlayAPI specific enhancements
}

vars:pre-request {
  expectedResponseTime: 20
  expectedResponseStatusCode: 200
  APP_ID: in.juspay.nammayatri
  COUNTRY_CODE: US
  LANGUAGE_CODE: en
  HOST: http://localhost:3001
}

tests {
  const expected = Number(bru.getRequestVar("expectedResponseStatusCode") ?? 200);

  test("Status code matches expectedResponseStatusCode", function() {
    expect(res.getStatus()).to.equal(expected);
  });
}
