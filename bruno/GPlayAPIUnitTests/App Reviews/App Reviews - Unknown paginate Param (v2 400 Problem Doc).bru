meta {
  name: App Reviews - Unknown paginate Param (v2 400 Problem Doc)
  type: http
  seq: 6
}

get {
  url: {{HOST}}/v2/apps/{{APP_ID}}/reviews?num=2&paginate=true&country={{COUNTRY_CODE}}
  body: none
  auth: none
}

vars:pre-request {
  expectedResponseStatusCode: 400
}

tests {
  const responseData = res.getBody();

  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Response is an RFC 9457 problem document", function() {
    expect(responseData.type).to.exist;
    expect(responseData.title).to.exist;
    expect(responseData.status).to.equal(400);
    expect(responseData.detail).to.exist;
  });

  test("Error names the rejected paginate parameter", function() {
    expect(responseData.detail).to.include("paginate");
  });
}
