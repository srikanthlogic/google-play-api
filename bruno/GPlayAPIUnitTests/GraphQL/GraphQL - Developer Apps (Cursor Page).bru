meta {
  name: GraphQL - Developer Apps (Cursor Page)
  type: http
  seq: 8
}

post {
  url: {{HOST}}/v2/graphql
  body: graphql
  auth: none
}

headers {
  accept: application/json
}

body:graphql {
  {
    developerApps(devId: "Google LLC", pageSize: 3) {
      results {
        appId
        title
      }
      nextToken
    }
  }
}

tests {
  const responseData = res.getBody();

  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("No GraphQL errors", function() {
    expect(responseData.errors).to.be.undefined;
  });

  test("results respects pageSize", function() {
    expect(responseData.data.developerApps.results).to.be.an("array").with.lengthOf(3);
  });

  test("nextToken is an opaque cursor", function() {
    expect(responseData.data.developerApps.nextToken).to.be.a("string").and.to.have.lengthOf.at.least(1);
  });
}
