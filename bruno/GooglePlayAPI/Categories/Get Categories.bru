meta {
  name: Get Categories
  type: http
  seq: 1
}

get {
  url: {{HOST}}/api/categories
  body: none
  auth: none
}

tests {
  const responseData = res.getBody();
  
  test("Response is an array", function() {
    expect(responseData).to.be.an('array');
  });
  
  test("Response array contains at least one element", function() {
    expect(responseData).to.be.an('array').and.to.have.lengthOf.at.least(1);
  });
  
  test("Each element in the response array is a non-empty string", function() {
    expect(responseData).to.be.an('array');
    responseData.forEach(function(element) {
      expect(element).to.be.a('string').and.to.have.lengthOf.at.least(1, 'Value should not be empty');
    });
  });
  
  test("Number of categories to be greaterThan 10", function() {
    expect(responseData.length).is.greaterThan(10);
  });
  
  test("Check if FINANCE Category exists", function() {
    expect(responseData).to.include('FINANCE');
  });
}
